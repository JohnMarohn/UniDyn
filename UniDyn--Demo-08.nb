     RowBox[{"\[ImaginaryI]", " ", "t1", " ", "\[CapitalDelta]"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "t2", " ", "\[CapitalDelta]"}]}]], " ", 
   "g$I", " ", "g$S", " ", 
   SuperscriptBox["\[Omega]", "2"], " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"S$p", ",", "I$m"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "t1", " ", "\[CapitalDelta]"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "t2", " ", "\[CapitalDelta]"}]}]], " ", 
   SuperscriptBox["g$I", "2"], " ", 
   SuperscriptBox["\[Omega]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", "Iz", "+", 
     RowBox[{"2", " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"Iz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
