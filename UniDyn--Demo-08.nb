Cell[TextData[{
 "We can see that the concurrence is 1 when ",
 StyleBox["t",
  FontSlant->"Italic"],
 " is 0.25 and 0.75, corresponding to pulse angles  of \[Pi]/2 and 3\[Pi]/2."
}], "Text",
 CellChangeTimes->{{3.998582992320807*^9, 3.998583040130094*^9}, {
