  RowBox[{"Mult", "[", 
   RowBox[{"Ix", ",", "Sz"}], "]"}], "+", 
  RowBox[{"Mult", "[", 
   RowBox[{"Iy", ",", "Sy"}], "]"}], "+", 
  RowBox[{"Mult", "[", 
   RowBox[{"Iz", ",", "Sx"}], "]"}]}]], "Output",
