Cell[BoxData[
 RowBox[{"-", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"8", " ", "\[Pi]", " ", "\[CapitalDelta]"}]], 
   RowBox[{"\[ImaginaryI]", " ", "g$S", " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]"}], 
      "-", 
      RowBox[{
      "8", " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]", " ", "Sz"}], "+", 
      RowBox[{"4", " ", "\[ImaginaryI]", " ", "g$I", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$m", ",", "I$p"}], "]"}]}], "+", 
      RowBox[{"4", " ", "\[ImaginaryI]", " ", "g$I", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$p", ",", "I$m"}], "]"}]}], "-", 
      RowBox[{"16", " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], "+", 
      RowBox[{"2", " ", "g$I", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", "S$p"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Pi]", " ", 
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], "+", 
         FractionBox[
          RowBox[{"2", " ", "\[Pi]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], " ", 
              RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}]}], "-", 
             RowBox[{"Sin", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
               RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}], 
            ")"}]}], 
          RowBox[{
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}]], "-", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "\[Pi]", " ", 
            SqrtBox[
             FractionBox["1", 
              SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
            RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}]}], 
        ")"}]}], "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]], 
       RowBox[{"2", " ", "g$I", " ", 
        RowBox[{"Mult", "[", 
         RowBox[{"I$p", ",", "S$m"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"2", " ", "\[Pi]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"2", " ", "\[Pi]", " ", 
                 SqrtBox[
                  FractionBox["1", 
                   SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                 RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], " ", 
               RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}]}], "+", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}], 
             ")"}]}], 
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]]], "+", 
          RowBox[{
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
               RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], "-", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}]}], 
            ")"}]}]}], ")"}]}]}]}], ")"}]}]}]}]], "Output",
 CellChangeTimes->{3.998511422500627*^9, 3.998556753589281*^9, 
  3.998556849126018*^9, 3.998557494495151*^9, 3.998558094409389*^9, 
