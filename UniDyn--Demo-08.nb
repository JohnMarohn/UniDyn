Cell[TextData[{
 "The function ",
 StyleBox["f",
  FontSlant->"Italic"],
 " computes the concurrence as function of pulse angle."
}], "Text",
 CellChangeTimes->{{3.998582919732505*^9, 3.998582943706336*^9}, {
