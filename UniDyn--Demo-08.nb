Cell[BoxData[
 RowBox[{"H$1$int$0", " ", "=", 
  RowBox[{"Expand", "[", " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "t$c"], " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"H$1$int", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"t$c", " ", "->", " ", 
     FractionBox[
      RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}], "]"}]}]], "Input",
