Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\[Theta]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]1$mat", " ", "=", " ", 
   RowBox[{
    RowBox[{"matrixify", "[", "\[Rho]1", "]"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", " ", "\[CapitalOmega]"}], " ", "->", " ", "\[Theta]"}], 
     "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]1$mat", " ", "//", " ", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.998579147454586*^9, 3.998579161978044*^9}, {
