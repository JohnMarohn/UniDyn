    RowBox[{"Sin", "[", 
     RowBox[{"t", " ", "\[CapitalOmega]"}], "]"}], "2"]}], "-", 
  RowBox[{
   FractionBox["1", "4"], " ", "Iy", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "-", 
  RowBox[{
   FractionBox["1", "4"], " ", "Sy", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "-", 
