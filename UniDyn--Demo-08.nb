         RowBox[{"2", " ", 
          SuperscriptBox["g$S", "2"], " ", 
          RowBox[{"Mult", "[", 
           RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", 
