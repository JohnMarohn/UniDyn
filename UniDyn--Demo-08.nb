Cell[BoxData[
 RowBox[{"<<", "Matrices--two-spin-half.m"}]], "Input",
 CellChangeTimes->{{3.998572883880169*^9, 3.998572883881332*^9}},
 CellLabel->
  "In[1006]:=",ExpressionUUID->"7b0cd33c-ecbb-4106-b554-cf3701b76eb0"],

Cell[BoxData["\<\"Loaded spin one-half matrices for mIx, mIy, mIz, mSx, mSy, \
mSz\"\>"], "Print",
 CellChangeTimes->{
  3.998572884684141*^9, {3.9985807010292807`*^9, 3.998580729283381*^9}},
 CellLabel->
  "During evaluation of \
In[1006]:=",ExpressionUUID->"921e364b-489c-4fd1-80b6-af64759eb094"]
}, Open  ]],

Cell[TextData[{
 "Write the density operator in matrix form.  \n\nThis is tricky.  The \
\[OpenCurlyDoubleQuote]constant\[CloseCurlyDoubleQuote], non-operator, part \
of the density operator should be replaced by the 4 x 4 unit matrix (i.e., \
IdentityMatrix[4]).  In the code below we use the function ScalarPart[] to \
extract the scalar, ",
 StyleBox["non-operator part",
  FontSlant->"Italic"],
 " of the density operator.  Multiply this scalar part by the symbol Id \
(which we will substitute with IdentityMatrix[4]) and add it back to the \
remainder of the density operator.  Convert the result to matrix form using a \
set of substitutions."
}], "Text",
 CellChangeTimes->{{3.9985730026590033`*^9, 3.998573022513422*^9}, {
  3.9985809362422523`*^9, 3.998581126167645*^9}, {3.999071568664494*^9, 
  3.999071605705871*^9}},ExpressionUUID->"52ac1a31-ed4b-47ed-a3e9-\
c1049eec7061"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules1", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"Mult", "\[Rule]", "Dot"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules2", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Id", " ", "->", " ", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ",", " ", 
      RowBox[{"Ix", "\[Rule]", "mIx"}], ",", 
      RowBox[{"Iy", "\[Rule]", "mIy"}], ",", 
      RowBox[{"Iz", "\[Rule]", "mIz"}], ",", 
      RowBox[{"Sx", "\[Rule]", "mSx"}], ",", 
      RowBox[{"Sy", "\[Rule]", "mSy"}], ",", 
      RowBox[{"Sz", "\[Rule]", "mSz"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ScalarPart", "[", "expr_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"List", "@@", 
       RowBox[{"Expand", "[", "expr", "]"}]}], ",", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{"#", ",", 
         RowBox[{"_", "?", "OperatorQ"}]}], "]"}], "&"}]}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matrixify", "[", "rho_", "]"}], " ", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"scalarpart", ",", " ", "rho$", ",", " ", "rho$matrix"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"scalar", " ", "=", " ", 
      RowBox[{"ScalarPart", "[", "rho", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nonscalar", " ", "=", " ", 
      RowBox[{"rho", " ", "-", " ", "scalar"}]}], ";", "\[IndentingNewLine]", 
     " ", 
     RowBox[{"rho$", " ", "=", " ", 
      RowBox[{
       RowBox[{"scalar", " ", "*", " ", "Id"}], " ", "+", " ", 
       "nonscalar"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rho$matrix", " ", "=", " ", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"rho$", " ", "/.", " ", "rules1"}], ")"}], " ", "/.", " ", 
        "rules2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Tr[\[Rho]] = \>\"", ",", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Tr", "[", "rho$matrix", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Tr[\!\(\*SuperscriptBox[\(\[Rho]\), \(2\)]\)] = \>\"", ",", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"rho$matrix", "  ", ".", " ", "rho$matrix"}], "]"}], "]"}]}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "rho$matrix", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.998574241443162*^9, 3.998574251509573*^9}, {
   3.9985743036713448`*^9, 3.9985743084901752`*^9}, {3.9985743592978067`*^9, 
   3.9985743754072447`*^9}, {3.998574815524082*^9, 3.998574824634519*^9}, 
   3.998574871989805*^9, {3.998574916282155*^9, 3.998574916619257*^9}, {
   3.99857517913728*^9, 3.998575331133643*^9}, {3.99857873568681*^9, 
   3.9985788674517403`*^9}, {3.998579167273684*^9, 3.998579186526141*^9}, {
   3.998579226238122*^9, 3.99857923544379*^9}},
 CellLabel->
  "In[1007]:=",ExpressionUUID->"180355f0-2617-489a-be42-b6cfc737110c"],

Cell["\<\
Verify by inspection that the matrixify[] function works correctly on the \
initial density operator.
The atomic subsystems should be in the ground-state wavefunction |\[UpArrow]\
\[UpArrow]\[RightAngleBracket]  and we can verify that this is so by \
inspection.
We can also see that the initial density operator has unit trace, and its \
square has unit trace.\
\>", "Text",
 CellChangeTimes->{{3.998581151712175*^9, 3.998581346021961*^9}, {
  3.998581401558288*^9, 3.9985814688405533`*^9}, {3.998583475476015*^9, 
