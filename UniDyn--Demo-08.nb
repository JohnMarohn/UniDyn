Cell[CellGroupData[{

Cell["Version 2", "Subsection",
 CellChangeTimes->{{3.998488217566909*^9, 3.998488227235915*^9}, {
  3.998488373693734*^9, 
  3.998488375322154*^9}},ExpressionUUID->"d67cecc4-9c73-4361-860e-\
b205c8cde9dc"],

Cell[TextData[{
 "The cavity frequency is \[Omega] and atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " each has a resonance frequency \[Omega] - \[CapitalDelta] (detuned from \
the cavity resonance by an amount \[CapitalDelta]).  \nHere atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " are the same species.\n\nTake the coupling Hamiltonian into the \
interaction representation:"
}], "Text",
 CellChangeTimes->{{3.998488376401675*^9, 3.998488589338401*^9}, {
   3.9984887795165462`*^9, 3.99848884261727*^9}, {3.9984888941792803`*^9, 
   3.998488915710176*^9}, {3.998489359983349*^9, 3.9984893809992237`*^9}, 
   3.998510983868909*^9, 3.998511092723858*^9, {3.998511327341648*^9, 
   3.998511331075617*^9}, {3.998584899597131*^9, 
   3.998584899764874*^9}},ExpressionUUID->"25956b07-4e62-49a1-ad1e-\
5da2241fb559"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "H$1$int", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H$1$int", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Evolve", "[", 
        RowBox[{"H$0", ",", "t", ",", "H$1"}], "]"}], "  ", "/.", " ", 
       RowBox[{"Evolve", "->", " ", "Evolver2"}]}], ")"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]$I", " ", "->", " ", 
        RowBox[{"\[Omega]", " ", "-", " ", "\[CapitalDelta]"}]}], ",", " ", 
       RowBox[{"\[Omega]$S", " ", "->", " ", 
        RowBox[{"\[Omega]", " ", "-", " ", "\[CapitalDelta]"}]}]}], "}"}]}], 
    " ", "//", " ", "Simplify"}], " ", "//", " ", "Expand"}]}]}], "Input",
