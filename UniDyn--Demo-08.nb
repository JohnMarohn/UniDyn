Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], "+", 
  FractionBox["Ix", "4"], "+", 
  FractionBox["Sx", "4"], "+", 
  RowBox[{
   FractionBox["1", "4"], " ", "Ix", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "4"], " ", "Sx", " ", 
