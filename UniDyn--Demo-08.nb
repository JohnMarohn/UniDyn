Cell["Scalar parameters appearing the Hamiltonians .", "Text",
 CellChangeTimes->{{3.99849142857548*^9, 
  3.998491444299265*^9}},ExpressionUUID->"78e1f849-0926-44f1-b947-\
bb8a9e5a783d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreateScalar", "[", "\[IndentingNewLine]", 
   RowBox[{"\[Omega]", ",", "     ", 
    RowBox[{"(*", " ", 
     RowBox[{"cavity", " ", "frequency"}], " ", "*)"}], "\[IndentingNewLine]",
     "\[Omega]$I", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "frequency"}], " ", "*)"}], 
    "\[IndentingNewLine]", "\[Omega]$S", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"atom", " ", 
      StyleBox["S",
       FontSlant->"Italic"], " ", "frequency"}], " ", "*)"}], 
    "\[IndentingNewLine]", "g$I", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "unitless", " ", "coupling", " ", "constant", " ", "characterizing", " ",
       "the", " ", "interaction", " ", "of", " ", "atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "with", " ", "the", " ", "cavity", " ", 
      "mode"}], "  ", "*)"}], "\[IndentingNewLine]", "g$S", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "unitless", " ", "coupling", " ", "constant", " ", "characterizing", " ",
       "the", " ", "interaction", " ", "of", " ", "atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "with", " ", "the", " ", "cavity", " ", 
      "mode"}], "  ", "*)"}], "\[IndentingNewLine]", "\[CapitalDelta]"}], 
   "         ", 
   RowBox[{"(*", " ", 
    RowBox[{"resonance", " ", "offset"}], " ", "*)"}], "\[IndentingNewLine]", 
   "]"}], "      "}]], "Input",
 CellChangeTimes->{{3.998473343964209*^9, 3.998473390661879*^9}, {
  3.998491447952759*^9, 3.998491570862094*^9}},
 CellLabel->
  "In[191]:=",ExpressionUUID->"6f211b86-293f-4c15-943d-d1a174ce7ece"],

Cell[TextData[{
 "Hamiltonian for the bare atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " and the cavity."
}], "Text",
 CellChangeTimes->{{3.998491579376396*^9, 3.998491604659198*^9}, {
  3.998491669634829*^9, 
  3.998491670465872*^9}},ExpressionUUID->"59a77313-bbac-477b-b310-\
b8edb93b1bd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H$0", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]$I", " ", "Iz"}], " ", "+", " ", 
    RowBox[{"\[Omega]$S", " ", "Sz"}], " ", "+", " ", 
    RowBox[{"\[Omega]", " ", 
     RowBox[{"Mult", "[", 
      RowBox[{"aR", ",", " ", "aL"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998471725224483*^9, 3.998471727026033*^9}, {
  3.998473293205433*^9, 3.9984733031603327`*^9}, {3.998473394543559*^9, 
  3.998473434025429*^9}, {3.99847353681848*^9, 3.998473544781476*^9}},
 CellLabel->
  "In[192]:=",ExpressionUUID->"786e0649-b489-4782-876e-e37b8b861575"],

Cell[TextData[{
 "Coupling Hamiltonian describing the exchange of photons between atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and the cavity and atom ",
 StyleBox["S",
  FontSlant->"Italic"],
 " and the cavity."
}], "Text",
 CellChangeTimes->{{3.9984916068254967`*^9, 
  3.99849170182403*^9}},ExpressionUUID->"118f9fdf-a223-4134-acc0-\
43f09e4047ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H$1", " ", "=", " ", 
   RowBox[{
    RowBox[{"g$I", " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"I$p", ",", "aL"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", " ", "aR"}], "]"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"g$S", " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"S$p", ",", "aL"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$m", ",", " ", "aR"}], "]"}]}], ")"}]}]}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.998473442833294*^9, 3.9984735471900806`*^9}, {
   3.9984814208394823`*^9, 3.9984814428437443`*^9}, 3.998481574766918*^9},
 CellLabel->
  "In[193]:=",ExpressionUUID->"bff2cd24-43f9-44ad-8a76-9428a1900df1"],

Cell[CellGroupData[{

Cell["Version 1", "Subsection",
 CellChangeTimes->{{3.998488210383142*^9, 
  3.998488214418147*^9}},ExpressionUUID->"3f0ccb45-d777-4c7f-8cfe-\
2be880b3e07e"],

Cell[TextData[{
 "The cavity frequency is \[Omega], atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " has resonance frequency \[Omega] (in tune with the cavity resonance), and \
atom ",
 StyleBox["S",
  FontSlant->"Italic"],
 " has resonance frequency \[Omega] - \[CapitalDelta] (detuned from the \
cavity resonance by an amount \[CapitalDelta]).  Here atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " are different species.\n\nTake the coupling Hamiltonian into the \
interaction representation:"
}], "Text",
 CellChangeTimes->{{3.9984886011905622`*^9, 3.998488759277149*^9}, {
  3.99848884918006*^9, 3.998488880913198*^9}, {3.998489387097484*^9, 
  3.998489387369816*^9}},ExpressionUUID->"21797f24-ed2c-48b9-bd95-\
3041cbdd8dad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "H$1$int", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H$1$int", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Evolve", "[", 
        RowBox[{"H$0", ",", "t", ",", "H$1"}], "]"}], "  ", "/.", " ", 
       RowBox[{"Evolve", "->", " ", "Evolver2"}]}], ")"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]$I", " ", "->", " ", "\[Omega]"}], ",", " ", 
       RowBox[{"\[Omega]$S", " ", "->", " ", 
        RowBox[{"\[Omega]", " ", "-", " ", "\[CapitalDelta]"}]}]}], "}"}]}], 
    " ", "//", " ", "Simplify"}], " ", "//", " ", "Expand"}]}]}], "Input",
 CellChangeTimes->{{3.998480695946265*^9, 3.998480710547728*^9}, {
  3.9984807742600193`*^9, 3.9984809152597837`*^9}, {3.998481046700605*^9, 
  3.998481058598625*^9}},
 CellLabel->
  "In[194]:=",ExpressionUUID->"fe2a17b8-e4f2-479f-bb47-64bf34fae076"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g$I", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$m", ",", "aR"}], "]"}]}], "+", 
  RowBox[{"g$I", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$p", ",", "aL"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "\[CapitalDelta]"}]], " ",
    "g$S", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"S$m", ",", "aR"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[CapitalDelta]"}]], " ", "g$S", 
   " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"S$p", ",", "aL"}], "]"}]}]}]], "Output",
 CellChangeTimes->{
  3.9984807111522083`*^9, {3.998480775125579*^9, 3.998480814094735*^9}, {
   3.9984808745784483`*^9, 3.998480915778129*^9}, 3.998481059024542*^9, 
   3.998481493459571*^9, 3.998481581831244*^9, 3.998488282695956*^9, 
   3.9984883606421423`*^9, 3.9984895820533447`*^9, 3.9984903815204477`*^9, 
   3.9984911765486317`*^9, 3.998491305438011*^9, 3.9984917079328423`*^9},
 CellLabel->
  "Out[195]=",ExpressionUUID->"8a50dc51-d17d-4540-b03e-7f6ff2f036e1"]
}, Open  ]],

Cell["\<\
Using the Magnus expansion, compute a zeroth-order average Hamiltonian:\
\>", "Text",
 CellChangeTimes->{{3.99848893351805*^9, 
  3.998488981097124*^9}},ExpressionUUID->"fd5725da-8a76-4720-b4e2-\
8a7f98b069f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"H$1$int$0", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "t$c"], " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"H$1$int", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"t$c", " ", "->", " ", 
     FractionBox[
      RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}], "//", " ", 
   "Expand"}]}]], "Input",
 CellChangeTimes->{{3.998480933234034*^9, 3.9984809791043663`*^9}, {
  3.998481502650591*^9, 3.998481550790185*^9}},
 CellLabel->
  "In[196]:=",ExpressionUUID->"c9e7594b-611f-448e-ac12-3f90180c935c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g$I", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$m", ",", "aR"}], "]"}]}], "+", 
  RowBox[{"g$I", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$p", ",", "aL"}], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9984809564498568`*^9, 3.9984809798080482`*^9}, {
   3.9984814957365627`*^9, 3.9984815099435673`*^9}, 3.9984815520064173`*^9, 
   3.998481582408619*^9, 3.998488283282593*^9, 3.998488360973263*^9, 
   3.998489582635023*^9, 3.998490382102262*^9, 3.998491177122793*^9, 
   3.9984913060168133`*^9, 3.9984917085225563`*^9},
 CellLabel->
  "Out[196]=",ExpressionUUID->"62736959-56e5-477a-b2e9-4490b42afd1c"]
}, Open  ]],

Cell[TextData[{
 "To zeroth order, only atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " is coupled to the cavity."
}], "Text",
 CellChangeTimes->{{3.998488999090529*^9, 
  3.998489021374957*^9}},ExpressionUUID->"2cc1f78a-b938-4c77-b3de-\
81491e63123b"],

Cell["\<\
Using the Magnus expansion, compute a first-order average Hamiltonian:\
\>", "Text",
 CellChangeTimes->{{3.99848893351805*^9, 
  3.9984889692507753`*^9}},ExpressionUUID->"2d59fa22-1dc9-4045-9c51-\
0d3d3b33d140"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"H$1$int$1", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["I", 
      RowBox[{"2", " ", "t$c"}]]}], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Comm", "[", 
         RowBox[{
          RowBox[{"H$1$int", "[", "t1", "]"}], ",", 
          RowBox[{"H$1$int", "[", "t2", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t1", ",", " ", "0", ",", "t2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t2", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
   RowBox[{"t$c", "->", " ", 
    FractionBox[
     RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}]}]], "Input",
 CellChangeTimes->{{3.9984809979922037`*^9, 3.998481155037478*^9}, {
  3.998488253115206*^9, 3.998488253878325*^9}, {3.998488296914215*^9, 
  3.998488338414405*^9}},
 CellLabel->
  "In[197]:=",ExpressionUUID->"e4c540f1-570a-43d4-a6d1-cdf4ff1c14b9"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"8", " ", "\[Pi]", " ", "\[CapitalDelta]"}]], 
   RowBox[{"\[ImaginaryI]", " ", "g$S", " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]"}], 
      "-", 
      RowBox[{
      "8", " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]", " ", "Sz"}], "+", 
      RowBox[{"4", " ", "\[ImaginaryI]", " ", "g$I", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$m", ",", "I$p"}], "]"}]}], "+", 
      RowBox[{"4", " ", "\[ImaginaryI]", " ", "g$I", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$p", ",", "I$m"}], "]"}]}], "-", 
      RowBox[{"16", " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], "+", 
      RowBox[{"2", " ", "g$I", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", "S$p"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Pi]", " ", 
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], "+", 
         FractionBox[
          RowBox[{"2", " ", "\[Pi]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], " ", 
              RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}]}], "-", 
             RowBox[{"Sin", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
               RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}], 
            ")"}]}], 
          RowBox[{
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}]], "-", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "\[Pi]", " ", 
            SqrtBox[
             FractionBox["1", 
              SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
            RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}]}], 
        ")"}]}], "+", 
      FractionBox[
       RowBox[{"2", " ", "g$I", " ", 
        RowBox[{"Mult", "[", 
         RowBox[{"I$p", ",", "S$m"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"2", " ", "\[Pi]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"2", " ", "\[Pi]", " ", 
                 SqrtBox[
                  FractionBox["1", 
                   SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                 RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], " ", 
               RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}]}], "+", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}], 
             ")"}]}], 
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]]], "+", 
          RowBox[{
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
               RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], "-", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}]}], 
            ")"}]}]}], ")"}]}], 
       RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]]}], ")"}]}]}]}]], "Output",\

 CellChangeTimes->{{3.9984811286447153`*^9, 3.9984811615097313`*^9}, 
   3.998481593050667*^9, 3.9984882593239727`*^9, {3.9984882925306053`*^9, 
   3.9984883676795073`*^9}, 3.998489593360628*^9, 3.9984903927437773`*^9, 
   3.998491187760077*^9, 3.9984913167445307`*^9, 3.9984917163078613`*^9},
 CellLabel->
  "Out[197]=",ExpressionUUID->"525a0dd7-727d-4e3c-a038-37ca71e3739d"]
}, Open  ]],

Cell[TextData[{
 "Simplify the first-order average Hamiltonian by assuming that the resonance \
offset is positive.  \nUse sorted multiplication to put the ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " angular momentum operators in canonical order, with the ",
 StyleBox["I",
  FontSlant->"Italic"],
 "-atom operators first and the ",
 StyleBox["S",
  FontSlant->"Italic"],
 "-atom operators second."
}], "Text",
 CellChangeTimes->{{3.998489652044196*^9, 3.998489748209934*^9}, 
   3.998491032829937*^9},ExpressionUUID->"abe6ce1f-8f26-4207-bc95-\
36aeb003e96d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ans1", " ", "=", " ", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"H$1$int$1", ",", 
      RowBox[{"Assumptions", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Element", "[", 
          RowBox[{"\[CapitalDelta]", ",", "Reals"}], "]"}], ",", " ", 
         RowBox[{"\[CapitalDelta]", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}], 
    "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{"Mult", " ", "->", " ", "SortedMult"}], "}"}], " "}]}]], "Input",
 CellChangeTimes->{{3.9984811636994123`*^9, 3.9984812000252132`*^9}, {
  3.998481329400426*^9, 3.99848133011572*^9}, {3.998488167137155*^9, 
  3.998488179897808*^9}, {3.998491155198573*^9, 3.998491156284811*^9}},
 CellLabel->
  "In[198]:=",ExpressionUUID->"48ca6163-e096-49b1-ad06-691b073f4122"],

