Cell[BoxData[
 RowBox[{"\[Rho]1", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Evolve", "[", 
        RowBox[{"H$eff", " ", ",", "t", ",", "\[Rho]$init"}], "]"}], " ", "/.",
        " ", 
       RowBox[{"Evolve", " ", "->", " ", "Evolver1"}]}], " ", ")"}], "/.", 
     " ", 
     RowBox[{"Mult", "->", " ", "SortedMult"}]}], "  ", "//", " ", 
    "Simplify"}], " ", "//", " ", "Expand"}]}]], "Input",
 CellChangeTimes->{{3.998558127746779*^9, 3.998558229652493*^9}, {
  3.998558273863379*^9, 3.99855834717089*^9}, {3.998558626476506*^9, 
  3.9985586447700644`*^9}, {3.9985587124057207`*^9, 3.998558746404333*^9}, {
  3.9985606876152782`*^9, 3.998560693669652*^9}, {3.998560727103849*^9, 
  3.99856077651441*^9}, {3.9985610367183237`*^9, 3.9985610978275547`*^9}, {
  3.998561212438156*^9, 3.998561215910571*^9}, {3.9985612730013523`*^9, 
  3.998561277452701*^9}, {3.998561334990855*^9, 3.9985613352800198`*^9}, {
  3.998563373018511*^9, 3.998563454678348*^9}, {3.998563488437203*^9, 
  3.9985635354926367`*^9}, {3.998563590291917*^9, 3.99856364799682*^9}, {
  3.998563761400886*^9, 3.998563764457453*^9}, {3.998572223507617*^9, 
  3.998572238261002*^9}, {3.998572672397826*^9, 3.998572685614902*^9}},
 CellLabel->
  "In[917]:=",ExpressionUUID->"f1195f27-74ae-4ae2-8f0f-9c24a4dc1faa"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], "+", 
  FractionBox["Ix", "4"], "+", 
  FractionBox["Sx", "4"], "+", 
  RowBox[{
   FractionBox["1", "4"], " ", "Ix", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "4"], " ", "Sx", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"Cos", "[", 
     RowBox[{"t", " ", "\[CapitalOmega]"}], "]"}], "2"], " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"Ix", ",", "Sx"}], "]"}]}], "+", 
  RowBox[{
   RowBox[{"Mult", "[", 
    RowBox[{"Ix", ",", "Sz"}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{"t", " ", "\[CapitalOmega]"}], "]"}], "2"]}], "+", 
  RowBox[{
   RowBox[{"Mult", "[", 
    RowBox[{"Iy", ",", "Sy"}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{"t", " ", "\[CapitalOmega]"}], "]"}], "2"]}], "+", 
  RowBox[{
   RowBox[{"Mult", "[", 
    RowBox[{"Iz", ",", "Sx"}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     RowBox[{"t", " ", "\[CapitalOmega]"}], "]"}], "2"]}], "-", 
  RowBox[{
   FractionBox["1", "4"], " ", "Iy", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "-", 
  RowBox[{
   FractionBox["1", "4"], " ", "Sy", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "-", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"Ix", ",", "Sy"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "-", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"Iy", ",", "Sx"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"Iy", ",", "Sz"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"Iz", ",", "Sy"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", " ", "t", " ", "\[CapitalOmega]"}], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.998572673985091*^9, 3.9985726866046762`*^9}, 
   3.998572723475898*^9, 3.998579550170289*^9},
 CellLabel->
  "Out[917]=",ExpressionUUID->"b928dd0b-00a3-4f15-ba0a-9703e54455b4"]
}, Open  ]],

Cell["\<\
Check that we recover the initial density operator at time zero. 
We show below by looking at the \[Rho]1 matrix, that the associated \
wavefunction is simply

\t|\[UpArrow]\[UpArrow]\[RightAngleBracket]
\t
which is what we expect for the system in it ground state.\
\>", "Text",
 CellChangeTimes->{{3.998561425296891*^9, 3.99856144150182*^9}, {
   3.998583120402988*^9, 3.998583127130584*^9}, {3.998583169524234*^9, 
   3.99858324553481*^9}, 
   3.998583458822751*^9},ExpressionUUID->"972f249f-7e9d-44ff-986c-\
4899846e2391"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]1", " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "->", " ", "0"}], "}"}]}], " ", "//", " ", 
  "Expand"}]], "Input",
 CellChangeTimes->{{3.9985611312534227`*^9, 3.9985611483855352`*^9}, 
   3.998572731825241*^9},
 CellLabel->
  "In[691]:=",ExpressionUUID->"d2702082-a2cd-4e25-a770-9378fc993acd"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], "+", 
  FractionBox["Ix", "2"], "+", 
  FractionBox["Sx", "2"], "+", 
  RowBox[{"Mult", "[", 
   RowBox[{"Ix", ",", "Sx"}], "]"}]}]], "Output",
