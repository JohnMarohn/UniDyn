  RowBox[{"H$1", " ", "=", " ", 
   RowBox[{
    RowBox[{"g$I", " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"I$p", ",", "aL"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", " ", "aR"}], "]"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"g$S", " ", "\[Omega]", " ", 
     RowBox[{"(", 
