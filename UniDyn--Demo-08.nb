      RowBox[{"(", 
       RowBox[{"Iz", "+", 
        RowBox[{"Mult", "[", 
         RowBox[{"Iz", ",", "aR", ",", "aL"}], "]"}]}], ")"}]}]}], ")"}]}], 
  "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "t1", " ", "\[CapitalDelta]"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "t2", " ", "\[CapitalDelta]"}]}]], " ", 
   SuperscriptBox["g$S", "2"], " ", 
   SuperscriptBox["\[Omega]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", "Sz", "+", 
     RowBox[{"2", " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "t1", " ", "\[CapitalDelta]"}], 
     "+", 
     RowBox[{"\[ImaginaryI]", " ", "t2", " ", "\[CapitalDelta]"}]}]], " ", 
   SuperscriptBox["g$S", "2"], " ", 
   SuperscriptBox["\[Omega]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], "+", "Sz", "-", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"Sz", "+", 
        RowBox[{"Mult", "[", 
         RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], ")"}]}]}], 
    ")"}]}]}]], "Output",
 CellChangeTimes->{{3.998556730798135*^9, 3.998556753999723*^9}, 
   3.9985568068879747`*^9, 3.998556849544285*^9, 3.99855749492671*^9, 
