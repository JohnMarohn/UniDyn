Cell[TextData[{
 "Compute the post-interaction density operator at a time at which the \
equivalent pulse angle is \[Pi]/2.  \nWe will show below, numerically, that \
this is a maximally entangled state of the two qubits.\nThe post-interaction \
density operator corresponds to a wavefunction of \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", " ", 
     RowBox[{
      TemplateBox[{
        RowBox[{"\[UpArrow]", "\[UpArrow]"}]},
       "Ket"], "-", " ", 
      TemplateBox[{
        RowBox[{"\[UpArrow]", "\[DownArrow]"}]},
       "Ket"], "-", 
      TemplateBox[{
        RowBox[{"\[DownArrow]", "\[UpArrow]"}]},
       "Ket"], "-", 
      TemplateBox[{
        RowBox[{"\[DownArrow]", "\[DownArrow]"}]},
       "Ket"]}], ")"}], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81e4a3f2-986e-490a-969c-831ffc327289"],
 "\n\t\nwhich we determined with the help of Anthropic\[CloseCurlyQuote]s \
Claude AI."
}], "Text",
 CellChangeTimes->{{3.998572762623415*^9, 3.998572799626803*^9}, {
  3.9985806928942127`*^9, 3.998580696205571*^9}, {3.998583069690503*^9, 
  3.998583147212366*^9}, {3.998583257815236*^9, 3.998583322842493*^9}, {
  3.998583377212776*^9, 3.998583450092574*^9}, {3.99858348954451*^9, 
  3.9985835843405237`*^9}},ExpressionUUID->"6c80eec5-b777-4d58-8c3a-\
2311f80cc622"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]1$special", " ", "=", " ", 
  RowBox[{
   RowBox[{"\[Rho]1", "/.", " ", 
    RowBox[{"{", 
     RowBox[{"t", "->", " ", 
      RowBox[{
       FractionBox["\[Pi]", "2"], 
       FractionBox["1", "\[CapitalOmega]"]}]}], "}"}]}], " ", "//", " ", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9985637771680403`*^9, 3.998563860072838*^9}, 
   3.998572757249179*^9, {3.998572950943635*^9, 3.99857296720853*^9}, 
