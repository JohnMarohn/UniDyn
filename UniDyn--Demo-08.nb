 RowBox[{
  RowBox[{"SetDirectory", "[", "$UniDynPath", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.97568777675075*^9, 3.9756877889733067`*^9}},
 FontSize->14,
 CellLabel->"In[7]:=",ExpressionUUID->"f8483a0f-1cc7-47af-bd7b-1af87f66257d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fn", " ", "=", " ", 
   RowBox[{"FileNames", "[", "\"\<*-tests.m\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"test$report", " ", "=", 
   RowBox[{"TestReport", " ", "/@", " ", "fn"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"test$report", " ", "[", 
     RowBox[{"[", "k", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", 
      RowBox[{"Length", "[", "test$report", "]"}]}], "}"}]}], "]"}], 
  "]"}]}], "Input",
 FontSize->14,
