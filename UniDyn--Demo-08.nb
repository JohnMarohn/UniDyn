  3.9984807111522083`*^9, {3.998480775125579*^9, 3.998480814094735*^9}, {
   3.9984808745784483`*^9, 3.998480915778129*^9}, 3.998481059024542*^9, 
   3.998481493459571*^9, 3.998481581831244*^9, 3.998481951620214*^9, 
   3.998488292616737*^9, 3.998488367778103*^9, 3.998489593461163*^9, 
   3.998490392852586*^9, 3.9984911878606052`*^9, 3.998491316849306*^9, 
