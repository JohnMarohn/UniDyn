Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "t1", " ", "\[CapitalDelta]"}], 
      "+", 
      RowBox[{"\[ImaginaryI]", " ", "t2", " ", "\[CapitalDelta]"}]}]]}], " ", 
   "g$I", " ", "g$S", " ", 
   SuperscriptBox["\[Omega]", "2"], " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$m", ",", "S$p"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "t1", " ", "\[CapitalDelta]"}], "-", 
