Cell[TextData[{
 "To zeroth order, only atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " is coupled to the cavity."
}], "Text",
 CellChangeTimes->{{3.998488999090529*^9, 
  3.998489021374957*^9}},ExpressionUUID->"2cc1f78a-b938-4c77-b3de-\
81491e63123b"],

Cell["\<\
Using the Magnus expansion, compute a first-order average Hamiltonian:\
\>", "Text",
 CellChangeTimes->{{3.99848893351805*^9, 
  3.9984889692507753`*^9}},ExpressionUUID->"2d59fa22-1dc9-4045-9c51-\
0d3d3b33d140"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"H$1$int$1", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["I", 
      RowBox[{"2", " ", "t$c"}]]}], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Comm", "[", 
         RowBox[{
          RowBox[{"H$1$int", "[", "t1", "]"}], ",", 
          RowBox[{"H$1$int", "[", "t2", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t1", ",", " ", "0", ",", "t2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t2", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
   RowBox[{"t$c", "->", " ", 
    FractionBox[
     RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}]}]], "Input",
 CellChangeTimes->{{3.9984809979922037`*^9, 3.998481155037478*^9}, {
  3.998488253115206*^9, 3.998488253878325*^9}, {3.998488296914215*^9, 
  3.998488338414405*^9}},
 CellLabel->
  "In[523]:=",ExpressionUUID->"e4c540f1-570a-43d4-a6d1-cdf4ff1c14b9"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"8", " ", "\[Pi]", " ", "\[CapitalDelta]"}]], 
   RowBox[{"\[ImaginaryI]", " ", "g$S", " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]"}], 
      "-", 
      RowBox[{
      "8", " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]", " ", "Sz"}], "+", 
      RowBox[{"4", " ", "\[ImaginaryI]", " ", "g$I", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$m", ",", "I$p"}], "]"}]}], "+", 
      RowBox[{"4", " ", "\[ImaginaryI]", " ", "g$I", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$p", ",", "I$m"}], "]"}]}], "-", 
      RowBox[{"16", " ", "\[ImaginaryI]", " ", "g$S", " ", "\[Pi]", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], "+", 
      RowBox[{"2", " ", "g$I", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", "S$p"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Pi]", " ", 
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], "+", 
         FractionBox[
          RowBox[{"2", " ", "\[Pi]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], " ", 
              RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}]}], "-", 
             RowBox[{"Sin", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
               RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}], 
            ")"}]}], 
          RowBox[{
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}]], "-", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "\[Pi]", " ", 
            SqrtBox[
             FractionBox["1", 
              SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
            RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}]}], 
        ")"}]}], "+", 
      FractionBox[
       RowBox[{"2", " ", "g$I", " ", 
        RowBox[{"Mult", "[", 
         RowBox[{"I$p", ",", "S$m"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"2", " ", "\[Pi]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[ImaginaryI]", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"2", " ", "\[Pi]", " ", 
                 SqrtBox[
                  FractionBox["1", 
                   SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                 RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], " ", 
               RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}]}], "+", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}], 
             ")"}]}], 
           SqrtBox[
            FractionBox["1", 
             SuperscriptBox["\[CapitalDelta]", "2"]]]], "+", 
          RowBox[{
           RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"Cos", "[", 
              RowBox[{"2", " ", "\[Pi]", " ", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
               RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}], "-", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"Sign", "[", "\[CapitalDelta]", "]"}], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                SqrtBox[
                 FractionBox["1", 
                  SuperscriptBox["\[CapitalDelta]", "2"]]], " ", 
                RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]}], "]"}]}]}], 
            ")"}]}]}], ")"}]}], 
       RowBox[{"Abs", "[", "\[CapitalDelta]", "]"}]]}], ")"}]}]}]}]], "Output",\

 CellChangeTimes->{3.998511422500627*^9, 3.998556753589281*^9, 
  3.998556849126018*^9, 3.998557494495151*^9, 3.998558094409389*^9, 
  3.998558687334532*^9},
 CellLabel->
  "Out[523]=",ExpressionUUID->"ead8360a-d345-45c2-ae56-b74c3f74bd75"]
}, Open  ]],

Cell[TextData[{
 "Simplify the first-order average Hamiltonian by assuming that the resonance \
offset is positive.  \nUse sorted multI$plication to put the ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " angular momentum operators in canonical order, with the ",
 StyleBox["I",
  FontSlant->"Italic"],
 "-atom operators first and the ",
 StyleBox["S",
  FontSlant->"Italic"],
 "-atom operators second."
}], "Text",
 CellChangeTimes->{{3.998489652044196*^9, 3.998489748209934*^9}, 
   3.998491032829937*^9, {3.998510952142511*^9, 3.9985109797218513`*^9}, {
   3.998511214970635*^9, 
   3.998511215375142*^9}},ExpressionUUID->"abe6ce1f-8f26-4207-bc95-\
36aeb003e96d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ans1", " ", "=", " ", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"H$1$int$1", ",", 
      RowBox[{"Assumptions", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Element", "[", 
          RowBox[{"\[CapitalDelta]", ",", "Reals"}], "]"}], ",", " ", 
         RowBox[{"\[CapitalDelta]", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}], 
    "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{"Mult", " ", "->", " ", "SortedMult"}], "}"}], " "}]}]], "Input",
 CellChangeTimes->{{3.9984811636994123`*^9, 3.9984812000252132`*^9}, {
   3.998481329400426*^9, 3.99848133011572*^9}, {3.998488167137155*^9, 
   3.998488179897808*^9}, {3.998491155198573*^9, 3.998491156284811*^9}, 
   3.998510952144405*^9, {3.998511220552313*^9, 3.998511220956586*^9}},
 CellLabel->
  "In[524]:=",ExpressionUUID->"48ca6163-e096-49b1-ad06-691b073f4122"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["g$S", "2"], " ", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{"2", " ", "\[CapitalDelta]"}]]}], "-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["g$S", "2"], " ", "Sz", " ", 
    SuperscriptBox["\[Omega]", "2"]}], "\[CapitalDelta]"], "+", 
  FractionBox[
   RowBox[{"g$I", " ", "g$S", " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"Mult", "[", 
     RowBox[{"I$m", ",", "S$p"}], "]"}]}], "\[CapitalDelta]"], "+", 
  FractionBox[
   RowBox[{"g$I", " ", "g$S", " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"Mult", "[", 
     RowBox[{"I$p", ",", "S$m"}], "]"}]}], "\[CapitalDelta]"], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["g$S", "2"], " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"Mult", "[", 
     RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], 
   "\[CapitalDelta]"]}]], "Output",
 CellChangeTimes->{3.9985114225497923`*^9, 3.99855675363363*^9, 
  3.998556849168005*^9, 3.9985574945456944`*^9, 3.998558094459516*^9, 
  3.998558687377631*^9},
 CellLabel->
  "Out[524]=",ExpressionUUID->"2af19bde-9d0c-4bc0-8816-a9cab8cf8dde"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{"ans1", " ", ",", 
   FractionBox[
    SuperscriptBox["\[Omega]", "2"], "\[CapitalDelta]"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9984911668409777`*^9, 3.998491167457676*^9}},
