Cell["\<\
A measure of the entanglement of two qubits is the value of the Wootters\
\[CloseCurlyQuote] concurrence function, doi:10.1103/PhysRevLett.80.2245.
The following concurrent-computing function was developed in collaboration \
with Anthropic\[CloseCurlyQuote]s Claude AI.\
\>", "Text",
 CellChangeTimes->{{3.9985814769248466`*^9, 3.998581481017633*^9}, {
  3.998581524881176*^9, 3.998581615221736*^9}, {3.998582651493165*^9, 
  3.998582665226495*^9}, {3.9985828405191402`*^9, 
  3.998582842971607*^9}},ExpressionUUID->"c05f0c87-7c3c-4d57-8757-\
1cc0fce41f4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Concurrence", "[", "rho_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sy", ",", "rhoTilde", ",", "R", ",", "eigs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sy", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "I"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"I", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rhoTilde", "=", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"sy", ",", "sy"}], "]"}], ".", 
       RowBox[{"Conjugate", "[", "rho", "]"}], ".", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"sy", ",", "sy"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"rho", ".", "rhoTilde"}]}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"eigs", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"Chop", "[", 
           RowBox[{"Eigenvalues", "[", "R", "]"}], "]"}], "]"}], ",", 
         "Greater"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Max", "[", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"eigs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "-", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.998573161074655*^9, 3.998573171807007*^9}, {
   3.998573287807021*^9, 3.998573292791049*^9}, {3.99857335596819*^9, 
   3.9985733600348663`*^9}, {3.998573562337244*^9, 3.998573562659759*^9}, {
   3.998573603000492*^9, 3.998573612302215*^9}, 3.99857368670588*^9, {
   3.998579076978345*^9, 3.998579098322452*^9}, {3.998580529734212*^9, 
   3.99858054830676*^9}},
 CellLabel->
  "In[1016]:=",ExpressionUUID->"b9c97f22-e3c4-4940-8065-7deacc66c975"],

