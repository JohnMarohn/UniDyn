  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["g$S", "2"], " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"Mult", "[", 
     RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], 
   "\[CapitalDelta]"]}]], "Output",
