  3.998582986434099*^9}},ExpressionUUID->"3c509c81-2198-4a43-b229-\
adb2cc654e88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "t_", "]"}], " ", ":=", " ", 
  RowBox[{"Concurrence", "[", 
   RowBox[{"\[Rho]1$mat", " ", "/.", " ", 
