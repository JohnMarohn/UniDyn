  3.998491670465872*^9}},ExpressionUUID->"59a77313-bbac-477b-b310-\
b8edb93b1bd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H$0", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]$I", " ", "Iz"}], " ", "+", " ", 
    RowBox[{"\[Omega]$S", " ", "Sz"}], " ", "+", " ", 
    RowBox[{"\[Omega]", " ", 
     RowBox[{"Mult", "[", 
      RowBox[{"aR", ",", " ", "aL"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998471725224483*^9, 3.998471727026033*^9}, {
