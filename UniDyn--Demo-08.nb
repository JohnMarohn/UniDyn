Cell[TextData[{
 "Use sorted multiplication to put the ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " angular momentum operators in canonical order, with the ",
 StyleBox["I",
  FontSlant->"Italic"],
 "-atom operators first and the ",
 StyleBox["S",
  FontSlant->"Italic"],
 "-atom operators second."
}], "Text",
