Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[Omega]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["g$S", "2"], "2"]}], "-", 
     RowBox[{
      SuperscriptBox["g$S", "2"], " ", "Sz"}], "+", 
     RowBox[{"g$I", " ", "g$S", " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"I$m", ",", "S$p"}], "]"}]}], "+", 
     RowBox[{"g$I", " ", "g$S", " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"I$p", ",", "S$m"}], "]"}]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["g$S", "2"], " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], 
