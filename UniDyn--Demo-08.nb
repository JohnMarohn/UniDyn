Cell["\<\
Using the Magnus expansion, compute a first-order average Hamiltonian:\
\>", "Text",
 CellChangeTimes->{{3.99848893351805*^9, 
  3.9984889692507753`*^9}},ExpressionUUID->"6a27e6ec-7d5b-4222-b341-\
d05372aa04c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"H$1$int$1", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["I", 
      RowBox[{"2", " ", "t$c"}]]}], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Comm", "[", 
         RowBox[{
          RowBox[{"H$1$int", "[", "t1", "]"}], ",", 
          RowBox[{"H$1$int", "[", "t2", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t1", ",", " ", "0", ",", "t2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t2", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
   RowBox[{"t$c", "->", " ", 
    FractionBox[
     RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}]}]], "Input",
 CellLabel->
  "In[204]:=",ExpressionUUID->"33c169bf-8cf6-4f08-8657-c014a5b42205"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"8", " ", "\[Pi]", " ", "\[CapitalDelta]"}]], 
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["g$I", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "Iz"}]}], ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["g$S", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "Sz"}]}], ")"}]}]}], ")"}]}], "-", 
      RowBox[{"2", " ", "g$I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"g$S", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Mult", "[", 
             RowBox[{"I$p", ",", "S$m"}], "]"}], "+", 
            RowBox[{"Mult", "[", 
             RowBox[{"S$p", ",", "I$m"}], "]"}]}], ")"}]}], "+", 
         RowBox[{"2", " ", "g$I", " ", 
          RowBox[{"Mult", "[", 
           RowBox[{"Iz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"4", " ", 
       SuperscriptBox["g$S", "2"], " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"g$I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"g$S", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Mult", "[", 
                RowBox[{"I$m", ",", "S$p"}], "]"}], "+", 
               RowBox[{"Mult", "[", 
                RowBox[{"S$m", ",", "I$p"}], "]"}]}], ")"}]}], "+", 
            RowBox[{"2", " ", "g$I", " ", 
             RowBox[{"Mult", "[", 
              RowBox[{"Iz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["g$S", "2"], " ", 
          RowBox[{"Mult", "[", 
           RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"g$I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"g$S", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "\[ImaginaryI]"}], "+", 
                  RowBox[{"2", " ", "\[Pi]"}]}], ")"}], " ", 
                RowBox[{"Mult", "[", 
                 RowBox[{"I$m", ",", "S$p"}], "]"}]}], "+", 
               RowBox[{"\[ImaginaryI]", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Mult", "[", 
                   RowBox[{"I$p", ",", "S$m"}], "]"}], "-", 
                  RowBox[{"Mult", "[", 
                   RowBox[{"S$m", ",", "I$p"}], "]"}], "+", 
                  RowBox[{"Mult", "[", 
                   RowBox[{"S$p", ",", "I$m"}], "]"}]}], ")"}]}], "+", 
               RowBox[{"2", " ", "\[Pi]", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Mult", "[", 
                   RowBox[{"I$p", ",", "S$m"}], "]"}], "+", 
                  RowBox[{"Mult", "[", 
                   RowBox[{"S$m", ",", "I$p"}], "]"}], "+", 
                  RowBox[{"Mult", "[", 
                   RowBox[{"S$p", ",", "I$m"}], "]"}]}], ")"}]}]}], ")"}]}], 
            "+", 
            RowBox[{"8", " ", "g$I", " ", "\[Pi]", " ", 
             RowBox[{"Mult", "[", 
              RowBox[{"Iz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], "+", 
         RowBox[{"8", " ", 
          SuperscriptBox["g$S", "2"], " ", "\[Pi]", " ", 
          RowBox[{"Mult", "[", 
           RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}]}], 
     ")"}]}]}]}]], "Output",
 CellChangeTimes->{3.998481981046955*^9, 3.99848830550919*^9, 
