   " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"S$p", ",", "aL"}], "]"}]}]}]], "Output",
 CellChangeTimes->{
  3.998511422607074*^9, {3.998556737531136*^9, 3.998556753694285*^9}, 
   3.998556849233075*^9, 3.998557494605297*^9, 3.998558094515895*^9, 
