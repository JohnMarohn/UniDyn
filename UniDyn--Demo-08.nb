 CellLabel->"In[91]:=",ExpressionUUID->"48ca6163-e096-49b1-ad06-691b073f4122"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["g$S", "2"], " ", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{"2", " ", "\[CapitalDelta]"}]]}], "-", 
