Cell["Scalar parameters appearing the Hamiltonians .", "Text",
 CellChangeTimes->{{3.99849142857548*^9, 
  3.998491444299265*^9}},ExpressionUUID->"78e1f849-0926-44f1-b947-\
bb8a9e5a783d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreateScalar", "[", "\[IndentingNewLine]", 
   RowBox[{"\[Omega]", ",", "     ", 
    RowBox[{"(*", " ", 
     RowBox[{"cavity", " ", "frequency"}], " ", "*)"}], "\[IndentingNewLine]",
     "\[Omega]$I", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "frequency"}], " ", "*)"}], 
    "\[IndentingNewLine]", "\[Omega]$S", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"atom", " ", 
      StyleBox["S",
       FontSlant->"Italic"], " ", "frequency"}], " ", "*)"}], 
    "\[IndentingNewLine]", "g$I", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "unitless", " ", "coupling", " ", "constant", " ", "characterizing", " ",
       "the", " ", "interaction", " ", "of", " ", "atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "with", " ", "the", " ", "cavity", " ", 
      "mode"}], "  ", "*)"}], "\[IndentingNewLine]", "g$S", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "unitless", " ", "coupling", " ", "constant", " ", "characterizing", " ",
       "the", " ", "interaction", " ", "of", " ", "atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "with", " ", "the", " ", "cavity", " ", 
      "mode"}], "  ", "*)"}], "\[IndentingNewLine]", "\[CapitalDelta]"}], 
   "         ", 
   RowBox[{"(*", " ", 
    RowBox[{"resonance", " ", "offset"}], " ", "*)"}], "\[IndentingNewLine]", 
   "]"}], "      "}]], "Input",
 CellChangeTimes->{{3.998473343964209*^9, 3.998473390661879*^9}, {
  3.998491447952759*^9, 3.998491570862094*^9}},
 CellLabel->
  "In[517]:=",ExpressionUUID->"6f211b86-293f-4c15-943d-d1a174ce7ece"],

Cell[TextData[{
 "Hamiltonian for the bare atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " and the cavity."
}], "Text",
 CellChangeTimes->{{3.998491579376396*^9, 3.998491604659198*^9}, {
  3.998491669634829*^9, 
  3.998491670465872*^9}},ExpressionUUID->"59a77313-bbac-477b-b310-\
b8edb93b1bd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H$0", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]$I", " ", "Iz"}], " ", "+", " ", 
    RowBox[{"\[Omega]$S", " ", "Sz"}], " ", "+", " ", 
    RowBox[{"\[Omega]", " ", 
     RowBox[{"Mult", "[", 
      RowBox[{"aR", ",", " ", "aL"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998471725224483*^9, 3.998471727026033*^9}, {
  3.998473293205433*^9, 3.9984733031603327`*^9}, {3.998473394543559*^9, 
  3.998473434025429*^9}, {3.99847353681848*^9, 3.998473544781476*^9}},
 CellLabel->
  "In[518]:=",ExpressionUUID->"786e0649-b489-4782-876e-e37b8b861575"],

Cell[TextData[{
 "Coupling Hamiltonian describing the exchange of photons between atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and the cavity and atom ",
 StyleBox["S",
  FontSlant->"Italic"],
 " and the cavity."
}], "Text",
 CellChangeTimes->{{3.9984916068254967`*^9, 
  3.99849170182403*^9}},ExpressionUUID->"118f9fdf-a223-4134-acc0-\
43f09e4047ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H$1", " ", "=", " ", 
   RowBox[{
    RowBox[{"g$I", " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"I$p", ",", "aL"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", " ", "aR"}], "]"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"g$S", " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"S$p", ",", "aL"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$m", ",", " ", "aR"}], "]"}]}], ")"}]}]}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.998473442833294*^9, 3.9984735471900806`*^9}, {
   3.9984814208394823`*^9, 3.9984814428437443`*^9}, 3.998481574766918*^9, {
   3.998510651775962*^9, 3.998510669226945*^9}, {3.9985109521215754`*^9, 
