Cell[TextData[{
 "There are three physical effects contributed by the first-order terms.\n\n\t\
1) A shift in the atom ",
 StyleBox["S",
  FontSlant->"Italic"],
 " energy levels, proportional to (",
 StyleBox["n",
  FontSlant->"Italic"],
 " + 1/2), with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " the number of photons in the cavity.\n\t2) A shift in the atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " energy levels, proportional to (",
 StyleBox["n",
  FontSlant->"Italic"],
 " + 1/2), with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " the number of photons in the cavity.\n\t3) A coupling between atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["I", "-"], " ", 
     SubscriptBox["S", "+"]}], "+", 
    RowBox[{
     SubscriptBox["I", "+"], 
     SubscriptBox["S", "-"]}]}], TraditionalForm]],ExpressionUUID->
  "2b4d1210-5504-4beb-8836-454398196ec9"],
 ".\n\t\nWrite an effective Hamiltonian assuming there are ",
 StyleBox[" n ",
  FontSlant->"Italic"],
 "= 0 photons in the cavity, so that",
 "\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["I", "z"], " ", 
     SuperscriptBox["a", "\[Dagger]"], 
     RowBox[{"a", "\[LongRightArrow]", " ", 
      SubscriptBox["I", "z"]}], " ", 
     RowBox[{"n", " ", "\[LongRightArrow]", " ", "0", " "}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eff9dc2a-be59-4f1b-b4a9-35116fed644d"],
 " \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["S", "z"], " ", 
     SuperscriptBox["a", "\[Dagger]"], 
     RowBox[{"a", "\[LongRightArrow]", " ", 
      SubscriptBox["S", "z"]}], " ", 
     RowBox[{"n", " ", "\[LongRightArrow]", " ", "0", " "}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "76b4e2d8-cb50-4038-8851-da2f6d67666e"],
 " \n\t\nAlso set\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"I", " "}]], "\[LongRightArrow]", " ", "g"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5a7f64e-b1f5-48f4-aa8d-b4a6bc7ed490"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"I", " "}]], "\[LongRightArrow]", " ", "g", " "}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ba99ee7-115d-4289-9ee4-5cdd15e04a07"],
 "\n\nand write ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", 
    RowBox[{"+", 
     RowBox[{"/", "-"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b2b8efb-b697-471b-8dba-9fe77fbe6c99"],
 " and  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", 
    RowBox[{"+", 
     RowBox[{"/", "-"}]}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5fa8d898-e9c5-4b2a-ac52-09880044c0a3"],
 " in terms of the associated ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and ",
 StyleBox["y",
  FontSlant->"Italic"],
 " angular momentum operators."
}], "Text",
 CellChangeTimes->{{3.998489030273728*^9, 3.9984892756965847`*^9}, 
   3.9984897782940903`*^9, {3.998490969192576*^9, 3.998490993842409*^9}, {
   3.998491046011813*^9, 3.9984910491688137`*^9}, {3.99857226555284*^9, 
   3.998572563682666*^9}},ExpressionUUID->"9da30a7b-e1a7-45ed-9534-\
4a660078a3a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"H$eff", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Omega]", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["g$I", "2"], " ", "Iz"}], "+", 
          RowBox[{
           SuperscriptBox["g$S", "2"], " ", "Sz"}], "+", 
          RowBox[{"g$I", " ", "g$S", " ", 
           RowBox[{"Mult", "[", 
            RowBox[{"I$m", ",", "S$p"}], "]"}]}], "+", 
          RowBox[{"g$I", " ", "g$S", " ", 
           RowBox[{"Mult", "[", 
            RowBox[{"I$p", ",", "S$m"}], "]"}]}]}], ")"}]}], 
       "\[CapitalDelta]"]}], " ", "/.", "\[IndentingNewLine]", " ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"g$I", " ", "->", " ", "g"}], ",", " ", 
       RowBox[{"g$S", " ", "->", " ", "g"}], ",", "\[IndentingNewLine]", 
       RowBox[{"I$p", " ", "->", " ", 
        RowBox[{"Ix", " ", "+", " ", 
         RowBox[{"I", " ", "Iy"}]}]}], ",", " ", 
       RowBox[{"I$m", " ", "->", " ", 
        RowBox[{"Ix", " ", "-", " ", 
         RowBox[{"I", " ", "Iy"}]}]}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{"S$p", " ", "->", " ", 
        RowBox[{"Sx", " ", "+", " ", 
         RowBox[{"I", " ", "Sy"}]}]}], ",", " ", 
       RowBox[{"S$m", " ", "->", " ", 
        RowBox[{"Sx", " ", "-", " ", 
         RowBox[{"I", " ", "Sy"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"H$eff", " ", "=", " ", 
  RowBox[{"H$eff", "/.", " ", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["g", "2"], " ", 
      SuperscriptBox["\[Omega]", "2"]}], "\[CapitalDelta]"], " ", "->", " ", 
    "\[CapitalOmega]"}]}]}]}], "Input",
 CellChangeTimes->{{3.9985632160046988`*^9, 3.9985632764232197`*^9}, {
  3.9985633477391233`*^9, 3.99856335264148*^9}, {3.998572594043211*^9, 
  3.998572632852174*^9}},
 CellLabel->
  "In[685]:=",ExpressionUUID->"d01f2c5d-c366-470d-a845-d65ff4d8e4d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "\[CapitalOmega]"}], " ", 
  RowBox[{"(", 
   RowBox[{"Iz", "+", "Sz", "+", 
    RowBox[{"2", " ", 
     RowBox[{"Mult", "[", 
      RowBox[{"Ix", ",", "Sx"}], "]"}]}], "+", 
    RowBox[{"2", " ", 
     RowBox[{"Mult", "[", 
      RowBox[{"Iy", ",", "Sy"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9985726252758837`*^9, 3.998572637481409*^9}},
 CellLabel->
  "Out[686]=",ExpressionUUID->"30b59370-bdb7-4b41-a32c-8cfb74150f52"]
}, Open  ]],

Cell[TextData[{
 "Let us calculate the evolution of the full density operator\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     SuperscriptBox["0", "+"], ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "+", 
       SubscriptBox["I", "x"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "+", 
       SubscriptBox["S", "x"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36c1435e-7926-4b55-8bc4-6cd286c1e397"],
 "\n\t\nThis initial density operator can be created by applying a \[Pi]/2 \
pulse to both atoms, cooled to their ground state.\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", "0", ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "+", 
       SubscriptBox["I", "z"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "+", 
       SubscriptBox["S", "z"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad2d1e2b-88c3-42af-accd-c5afe3dea40b"]
}], "Text",
 CellChangeTimes->{{3.998560609567977*^9, 3.998560682484871*^9}, {
  3.9985613092457323`*^9, 3.998561376228425*^9}, {3.998571983222898*^9, 
  3.998572112346746*^9}, {3.998572652161541*^9, 
  3.998572657016395*^9}},ExpressionUUID->"4c0be6fb-de4c-48a6-bec4-\
bc56e4a56131"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]$0", " ", "=", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], "+", "Iz"}], ",", 
     RowBox[{
      FractionBox["1", "2"], "+", "Sz"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9985745014620953`*^9, 3.9985745228509808`*^9}},
 CellLabel->
  "In[788]:=",ExpressionUUID->"33a4d885-0d0f-4a63-a608-b2d41b07a4a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]$init", " ", "=", " ", 
  RowBox[{
   RowBox[{"Evolve", "[", 
    RowBox[{
     RowBox[{"w", " ", 
      RowBox[{"(", 
       RowBox[{"Sy", " ", "+", " ", "Iy"}], ")"}]}], ",", 
     RowBox[{
      FractionBox["1", "w"], 
      FractionBox["\[Pi]", "2"]}], ",", "\[Rho]$0"}], " ", "]"}], "  ", "/.", 
   " ", 
   RowBox[{"Evolve", " ", "->", " ", "Evolver2", " "}]}]}]], "Input",
 CellChangeTimes->{{3.99857213205796*^9, 3.998572215567865*^9}, 
   3.998574527016616*^9},
 CellLabel->
  "In[789]:=",ExpressionUUID->"871ca91c-5113-4e27-aa41-4bc25e19d316"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], "+", 
  FractionBox["Ix", "2"], "+", 
  FractionBox["Sx", "2"], "+", 
  RowBox[{"Mult", "[", 
   RowBox[{"Ix", ",", "Sx"}], "]"}]}]], "Output",
 CellChangeTimes->{{3.998572167221644*^9, 3.998572216259905*^9}, 
   3.998572664867427*^9, 3.9985745314162693`*^9},
 CellLabel->
  "Out[789]=",ExpressionUUID->"355ef4d2-656a-4af4-be83-9398b9ce80c9"]
}, Open  ]],

Cell["\<\
Evolve this initial density operator under the effective Hamiltonian\
\>", "Text",
 CellChangeTimes->{{3.998572676737186*^9, 
  3.998572719162591*^9}},ExpressionUUID->"91295bcd-478b-43ca-9f3a-\
463f30e3242f"],

