Cell[CellGroupData[{

Cell["Two two-level systems coupled to a common cavity", "Section",
 CellChangeTimes->{{3.998471307385799*^9, 
  3.998471331636589*^9}},ExpressionUUID->"d89360de-d4f4-46c5-898f-\
1ff826aa5d15"],

Cell["Clear all the symbols; start afresh.", "Text",
 CellChangeTimes->{{3.998491409756268*^9, 
  3.998491424335518*^9}},ExpressionUUID->"e2b35d5a-c843-4d37-8d79-\
6604a1e4b97f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "Ix", ",", " ", "Iy", ",", " ", "Iz", ",", " ", "Ip", ",", " ", "Im", ",", 
    "Sx", ",", " ", "Sy", ",", " ", "Sz", ",", " ", "Sp", ",", " ", "Sm", ",",
     " ", "aR", ",", " ", "aL"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "\[Omega]", ",", "\[Omega]$I", ",", " ", "\[Omega]$S", ",", " ", "g$I", 
    ",", " ", "g$S", ",", " ", "\[CapitalDelta]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"H$0", " ", ",", "H$1"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.998471334616377*^9, 3.998471398361891*^9}, {
  3.998471689208428*^9, 3.998471704290729*^9}, {3.998491277052577*^9, 
  3.998491302092662*^9}, {3.998510622287084*^9, 3.9985106271787663`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"2c0de618-ce5b-458c-b6e0-3bc59b7f7327"],

Cell[TextData[{
 "Create pseudo-spin operators for an ",
 StyleBox["I",
  FontSlant->"Italic"],
 " atom and an ",
 StyleBox["S",
  FontSlant->"Italic"],
 " atom.\nCreate raising and lowering operators for the single-mode cavity. "
}], "Text",
 CellChangeTimes->{{3.998491322810873*^9, 
  3.9984914069858513`*^9}},ExpressionUUID->"f356d283-8d9f-4bcd-bcca-\
c778271a4f20"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoSpinBoson$CreateOperators", "[", 
   RowBox[{
   "Ix", ",", " ", "Iy", ",", " ", "Iz", ",", " ", "I$p", ",", " ", "I$m", 
    ",", "Sx", ",", " ", "Sy", ",", " ", "Sz", ",", " ", "S$p", ",", " ", 
    "S$m", ",", "aR", ",", " ", "aL"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9984716434027977`*^9, 3.9984716613820047`*^9}, {
   3.9984718291851797`*^9, 3.998471850610211*^9}, 3.998472534776844*^9, 
   3.998491318555911*^9, {3.998510634237743*^9, 3.998510638625095*^9}, {
   3.998510952050975*^9, 3.9985110147608147`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"bf8fdfad-c69e-4840-aa02-31397f4c010c"],

Cell["Scalar parameters appearing the Hamiltonians .", "Text",
 CellChangeTimes->{{3.99849142857548*^9, 
  3.998491444299265*^9}},ExpressionUUID->"78e1f849-0926-44f1-b947-\
bb8a9e5a783d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CreateScalar", "[", "\[IndentingNewLine]", 
   RowBox[{"\[Omega]", ",", "     ", 
    RowBox[{"(*", " ", 
     RowBox[{"cavity", " ", "frequency"}], " ", "*)"}], "\[IndentingNewLine]",
     "\[Omega]$I", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "frequency"}], " ", "*)"}], 
    "\[IndentingNewLine]", "\[Omega]$S", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"atom", " ", 
      StyleBox["S",
       FontSlant->"Italic"], " ", "frequency"}], " ", "*)"}], 
    "\[IndentingNewLine]", "g$I", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "unitless", " ", "coupling", " ", "constant", " ", "characterizing", " ",
       "the", " ", "interaction", " ", "of", " ", "atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "with", " ", "the", " ", "cavity", " ", 
      "mode"}], "  ", "*)"}], "\[IndentingNewLine]", "g$S", ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "unitless", " ", "coupling", " ", "constant", " ", "characterizing", " ",
       "the", " ", "interaction", " ", "of", " ", "atom", " ", 
      StyleBox["I",
       FontSlant->"Italic"], " ", "with", " ", "the", " ", "cavity", " ", 
      "mode"}], "  ", "*)"}], "\[IndentingNewLine]", "\[CapitalDelta]"}], 
   "         ", 
   RowBox[{"(*", " ", 
    RowBox[{"resonance", " ", "offset"}], " ", "*)"}], "\[IndentingNewLine]", 
   "]"}], "      "}]], "Input",
 CellChangeTimes->{{3.998473343964209*^9, 3.998473390661879*^9}, {
  3.998491447952759*^9, 3.998491570862094*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"6f211b86-293f-4c15-943d-d1a174ce7ece"],

Cell[TextData[{
 "Hamiltonian for the bare atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " and the cavity."
}], "Text",
 CellChangeTimes->{{3.998491579376396*^9, 3.998491604659198*^9}, {
  3.998491669634829*^9, 
  3.998491670465872*^9}},ExpressionUUID->"59a77313-bbac-477b-b310-\
b8edb93b1bd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H$0", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Omega]$I", " ", "Iz"}], " ", "+", " ", 
    RowBox[{"\[Omega]$S", " ", "Sz"}], " ", "+", " ", 
    RowBox[{"\[Omega]", " ", 
     RowBox[{"Mult", "[", 
      RowBox[{"aR", ",", " ", "aL"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998471725224483*^9, 3.998471727026033*^9}, {
  3.998473293205433*^9, 3.9984733031603327`*^9}, {3.998473394543559*^9, 
  3.998473434025429*^9}, {3.99847353681848*^9, 3.998473544781476*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"786e0649-b489-4782-876e-e37b8b861575"],

Cell[TextData[{
 "Coupling Hamiltonian describing the exchange of photons between atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and the cavity and atom ",
 StyleBox["S",
  FontSlant->"Italic"],
 " and the cavity."
}], "Text",
 CellChangeTimes->{{3.9984916068254967`*^9, 
  3.99849170182403*^9}},ExpressionUUID->"118f9fdf-a223-4134-acc0-\
43f09e4047ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"H$1", " ", "=", " ", 
   RowBox[{
    RowBox[{"g$I", " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"I$p", ",", "aL"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", " ", "aR"}], "]"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"g$S", " ", "\[Omega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"S$p", ",", "aL"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"S$m", ",", " ", "aR"}], "]"}]}], ")"}]}]}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.998473442833294*^9, 3.9984735471900806`*^9}, {
   3.9984814208394823`*^9, 3.9984814428437443`*^9}, 3.998481574766918*^9, {
   3.998510651775962*^9, 3.998510669226945*^9}, {3.9985109521215754`*^9, 
   3.998510989793775*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"bff2cd24-43f9-44ad-8a76-9428a1900df1"],

Cell[CellGroupData[{

Cell["Version 1", "Subsection",
 CellChangeTimes->{{3.998488210383142*^9, 
  3.998488214418147*^9}},ExpressionUUID->"3f0ccb45-d777-4c7f-8cfe-\
2be880b3e07e"],

Cell[TextData[{
 "The cavity frequency is \[Omega], atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " has resonance frequency \[Omega] (in tune with the cavity resonance), and \
atom ",
 StyleBox["S",
  FontSlant->"Italic"],
 " has resonance frequency \[Omega] - \[CapitalDelta] (detuned from the \
cavity resonance by an amount \[CapitalDelta]).  Here atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " are different Species.\n\nTake the coupling Hamiltonian into the \
interaction representation:"
}], "Text",
 CellChangeTimes->{{3.9984886011905622`*^9, 3.998488759277149*^9}, {
   3.99848884918006*^9, 3.998488880913198*^9}, {3.998489387097484*^9, 
   3.998489387369816*^9}, 3.998510983857835*^9, 
   3.998511098488559*^9},ExpressionUUID->"21797f24-ed2c-48b9-bd95-\
3041cbdd8dad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "H$1$int", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H$1$int", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Evolve", "[", 
        RowBox[{"H$0", ",", "t", ",", "H$1"}], "]"}], "  ", "/.", " ", 
       RowBox[{"Evolve", "->", " ", "Evolver2"}]}], ")"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]$I", " ", "->", " ", "\[Omega]"}], ",", " ", 
       RowBox[{"\[Omega]$S", " ", "->", " ", 
        RowBox[{"\[Omega]", " ", "-", " ", "\[CapitalDelta]"}]}]}], "}"}]}], 
    " ", "//", " ", "Simplify"}], " ", "//", " ", "Expand"}]}]}], "Input",
 CellChangeTimes->{{3.998480695946265*^9, 3.998480710547728*^9}, {
   3.9984807742600193`*^9, 3.9984809152597837`*^9}, {3.998481046700605*^9, 
   3.998481058598625*^9}, 3.998510952122395*^9, {3.9985112091678877`*^9, 
   3.9985112095708323`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"fe2a17b8-e4f2-479f-bb47-64bf34fae076"],

Cell["\<\
Using the Magnus expansion, compute a zeroth-order average Hamiltonian:\
\>", "Text",
 CellChangeTimes->{{3.99848893351805*^9, 
  3.998488981097124*^9}},ExpressionUUID->"fd5725da-8a76-4720-b4e2-\
8a7f98b069f1"],

Cell[BoxData[
 RowBox[{"H$1$int$0", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "t$c"], " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"H$1$int", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"t$c", " ", "->", " ", 
     FractionBox[
      RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}], "//", " ", 
   "Expand"}]}]], "Input",
 CellChangeTimes->{{3.998480933234034*^9, 3.9984809791043663`*^9}, {
  3.998481502650591*^9, 3.998481550790185*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"c9e7594b-611f-448e-ac12-3f90180c935c"],

Cell[TextData[{
 "To zeroth order, only atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " is coupled to the cavity."
}], "Text",
 CellChangeTimes->{{3.998488999090529*^9, 
  3.998489021374957*^9}},ExpressionUUID->"2cc1f78a-b938-4c77-b3de-\
81491e63123b"],

Cell["\<\
Using the Magnus expansion, compute a first-order average Hamiltonian:\
\>", "Text",
 CellChangeTimes->{{3.99848893351805*^9, 
  3.9984889692507753`*^9}},ExpressionUUID->"2d59fa22-1dc9-4045-9c51-\
0d3d3b33d140"],

Cell[BoxData[
 RowBox[{"H$1$int$1", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["I", 
      RowBox[{"2", " ", "t$c"}]]}], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Comm", "[", 
         RowBox[{
          RowBox[{"H$1$int", "[", "t1", "]"}], ",", 
          RowBox[{"H$1$int", "[", "t2", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t1", ",", " ", "0", ",", "t2"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t2", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
   RowBox[{"t$c", "->", " ", 
    FractionBox[
     RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}]}]], "Input",
 CellChangeTimes->{{3.9984809979922037`*^9, 3.998481155037478*^9}, {
  3.998488253115206*^9, 3.998488253878325*^9}, {3.998488296914215*^9, 
  3.998488338414405*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"e4c540f1-570a-43d4-a6d1-cdf4ff1c14b9"],

Cell[TextData[{
 "Simplify the first-order average Hamiltonian by assuming that the resonance \
offset is positive.  \nUse sorted multI$plication to put the ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " angular momentum operators in canonical order, with the ",
 StyleBox["I",
  FontSlant->"Italic"],
 "-atom operators first and the ",
 StyleBox["S",
  FontSlant->"Italic"],
 "-atom operators second."
}], "Text",
 CellChangeTimes->{{3.998489652044196*^9, 3.998489748209934*^9}, 
   3.998491032829937*^9, {3.998510952142511*^9, 3.9985109797218513`*^9}, {
   3.998511214970635*^9, 
   3.998511215375142*^9}},ExpressionUUID->"abe6ce1f-8f26-4207-bc95-\
36aeb003e96d"],

Cell[BoxData[
 RowBox[{"ans1", " ", "=", " ", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"H$1$int$1", ",", 
      RowBox[{"Assumptions", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Element", "[", 
          RowBox[{"\[CapitalDelta]", ",", "Reals"}], "]"}], ",", " ", 
         RowBox[{"\[CapitalDelta]", " ", ">", " ", "0"}]}], "}"}]}]}], "]"}], 
    "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{"Mult", " ", "->", " ", "SortedMult"}], "}"}], " "}]}]], "Input",
 CellChangeTimes->{{3.9984811636994123`*^9, 3.9984812000252132`*^9}, {
   3.998481329400426*^9, 3.99848133011572*^9}, {3.998488167137155*^9, 
   3.998488179897808*^9}, {3.998491155198573*^9, 3.998491156284811*^9}, 
   3.998510952144405*^9, {3.998511220552313*^9, 3.998511220956586*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"48ca6163-e096-49b1-ad06-691b073f4122"],

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{"ans1", " ", ",", 
   FractionBox[
    SuperscriptBox["\[Omega]", "2"], "\[CapitalDelta]"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9984911668409777`*^9, 3.998491167457676*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"7611a445-6e5e-46c7-8354-eb499ab6ad7a"],

Cell[TextData[{
 "There are two physical effects contributed by the first-order terms.\n\n\t\
1) A shift in the atom",
 StyleBox[" S",
  FontSlant->"Italic"],
 " energy levels, proportional to (",
 StyleBox["n",
  FontSlant->"Italic"],
 " + 1/2), with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " the number of photons in the cavity.\n\t2) A coupling between atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["I", "-"], " ", 
     SubscriptBox["S", "+"]}], "+", 
    RowBox[{
     SubscriptBox["I", "+"], 
     SubscriptBox["S", "-"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "881f3c06-84f3-44c8-8765-9363473bb958"],
 "."
}], "Text",
 CellChangeTimes->{{3.998489030273728*^9, 3.9984892756965847`*^9}, 
   3.9984897782940903`*^9, {3.99849104240792*^9, 
   3.9984910432174664`*^9}},ExpressionUUID->"9a443ec0-2d28-4cc9-bef3-\
c907635be803"],

Cell[TextData[{
 "The coherence ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "558a2c8d-447e-44d3-ad96-63ca43af2269"],
 " will evolve under this Hamiltonian into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["I", "+"], 
     RowBox[{"Cos", "[", 
      RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}]}], " ", "+", " ", 
    RowBox[{"2", " ", "i", " ", 
     SubscriptBox["I", 
      RowBox[{"z", " "}]], 
     SubscriptBox["S", "+"], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da96fb71-a9cc-4775-96eb-12e55a5347f6"],
 ", entangling the electronic states of atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.99849074277491*^9, 3.998490902500154*^9}, {
  3.998490933913563*^9, 
  3.9984909345425053`*^9}},ExpressionUUID->"70fdb576-033c-4f49-8186-\
1c4517870cb5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Evolve", "[", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Mult", "[", 
        RowBox[{"I$m", ",", "S$p"}], "]"}], " ", "+", " ", 
       RowBox[{"Mult", "[", 
        RowBox[{"I$p", ",", "S$m"}], "]"}]}], ")"}]}], ",", " ", "t", ",", 
    " ", "I$p"}], "]"}], "  ", "/.", " ", 
  RowBox[{"Evolve", " ", "->", " ", "Evolver2", " "}]}]], "Input",
 CellChangeTimes->{{3.9984892846528053`*^9, 3.998489320727573*^9}, {
  3.998489402017488*^9, 3.998489505611745*^9}, {3.99848961123468*^9, 
  3.998489637465382*^9}, {3.9984904980101767`*^9, 3.9984907509701853`*^9}, {
  3.9985106518029118`*^9, 3.998510669231441*^9}, {3.9985109521622353`*^9, 
  3.9985109897977953`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"73511674-c0b0-4cf5-8b22-61659bc7fdff"]
}, Open  ]],

