Cell[TextData[{
 "The cavity frequency is \[Omega] and atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " ",
 "each has a resonance frequency \[Omega] - \[CapitalDelta] (detuned from the \
cavity resonance by an amount \[CapitalDelta]).  Here atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " are the same species.\n\nTake the coupling Hamiltonian into the \
interaction representation:"
}], "Text",
 CellChangeTimes->{{3.998488376401675*^9, 3.998488589338401*^9}, {
  3.9984887795165462`*^9, 3.99848884261727*^9}, {3.9984888941792803`*^9, 
  3.998488915710176*^9}, {3.998489359983349*^9, 
  3.9984893809992237`*^9}},ExpressionUUID->"25956b07-4e62-49a1-ad1e-\
5da2241fb559"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "H$1$int", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H$1$int", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Evolve", "[", 
        RowBox[{"H$0", ",", "t", ",", "H$1"}], "]"}], "  ", "/.", " ", 
       RowBox[{"Evolve", "->", " ", "Evolver2"}]}], ")"}], " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]$I", " ", "->", " ", 
        RowBox[{"\[Omega]", " ", "-", " ", "\[CapitalDelta]"}]}], ",", " ", 
       RowBox[{"\[Omega]$S", " ", "->", " ", 
        RowBox[{"\[Omega]", " ", "-", " ", "\[CapitalDelta]"}]}]}], "}"}]}], 
    " ", "//", " ", "Simplify"}], " ", "//", " ", "Expand"}]}]}], "Input",
 CellChangeTimes->{{3.998480695946265*^9, 3.998480710547728*^9}, {
  3.9984807742600193`*^9, 3.9984809152597837`*^9}, {3.998481046700605*^9, 
  3.998481058598625*^9}, {3.9984819474217463`*^9, 3.9984819503485613`*^9}},
 CellLabel->
  "In[201]:=",ExpressionUUID->"0a120fd7-cb06-4534-b0fa-bfc35692f8a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "\[CapitalDelta]"}]], " ",
    "g$I", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$m", ",", "aR"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[CapitalDelta]"}]], " ", "g$I", 
   " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$p", ",", "aL"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", "\[CapitalDelta]"}]], " ",
    "g$S", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"S$m", ",", "aR"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[CapitalDelta]"}]], " ", "g$S", 
   " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"S$p", ",", "aL"}], "]"}]}]}]], "Output",
