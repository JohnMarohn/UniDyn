   RowBox[{"g$I", " ", "g$S", " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"Mult", "[", 
     RowBox[{"I$p", ",", "S$m"}], "]"}]}], "\[CapitalDelta]"], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["g$I", "2"], " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"Mult", "[", 
     RowBox[{"Iz", ",", "aR", ",", "aL"}], "]"}]}], "\[CapitalDelta]"], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["g$S", "2"], " ", 
    SuperscriptBox["\[Omega]", "2"], " ", 
    RowBox[{"Mult", "[", 
     RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}], 
   "\[CapitalDelta]"]}]], "Output",
 CellChangeTimes->{{3.9984820214902687`*^9, 3.9984820520779333`*^9}, {
   3.9984879963996696`*^9, 3.99848801394215*^9}, {3.998488105177657*^9, 
   3.9984881560037003`*^9}, 3.9984883055267*^9, 3.998488368897976*^9, 
   3.998489606511698*^9, 3.998490404231357*^9, 3.998491085796357*^9, 
   3.998491200510952*^9, 3.9984913295327377`*^9, 3.998491724882949*^9},
 CellLabel->
  "Out[205]=",ExpressionUUID->"4002eb41-9f94-4b6d-87f2-9cb7cd00be00"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{"ans2", " ", ",", 
   FractionBox[
    SuperscriptBox["\[Omega]", "2"], "\[CapitalDelta]"]}], "]"}]], "Input",
 CellChangeTimes->{{3.998491087280755*^9, 3.998491121027116*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"e5256caa-7f84-4065-b9a4-f66ddf055ccd"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[Omega]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["g$I", "2"], "2"]}], "-", 
     FractionBox[
      SuperscriptBox["g$S", "2"], "2"], "-", 
     RowBox[{
      SuperscriptBox["g$I", "2"], " ", "Iz"}], "-", 
     RowBox[{
      SuperscriptBox["g$S", "2"], " ", "Sz"}], "-", 
     RowBox[{"g$I", " ", "g$S", " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"I$m", ",", "S$p"}], "]"}]}], "-", 
     RowBox[{"g$I", " ", "g$S", " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"I$p", ",", "S$m"}], "]"}]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["g$I", "2"], " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"Iz", ",", "aR", ",", "aL"}], "]"}]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["g$S", "2"], " ", 
      RowBox[{"Mult", "[", 
       RowBox[{"Sz", ",", "aR", ",", "aL"}], "]"}]}]}], ")"}]}], 
  "\[CapitalDelta]"]], "Output",
 CellChangeTimes->{{3.998491110346463*^9, 3.998491121836533*^9}, 
   3.998491200513879*^9, 3.9984913295408573`*^9, 3.998491724896061*^9},
 CellLabel->
  "Out[206]=",ExpressionUUID->"2a0c2e08-c2d1-47d7-9ebe-0ba951cfc2c0"]
}, Open  ]],

Cell[TextData[{
 "There are three physical effects contributed by the first-order terms.\n\n\t\
1) A shift in the atom ",
 StyleBox["S",
  FontSlant->"Italic"],
 " energy levels, proportional to (",
 StyleBox["n",
  FontSlant->"Italic"],
 " + 1/2), with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " the number of photons in the cavity.\n\t2) A shift in the atom ",
 StyleBox["I",
  FontSlant->"Italic"],
 " energy levels, proportional to (",
 StyleBox["n",
  FontSlant->"Italic"],
 " + 1/2), with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " the number of photons in the cavity.\n\t3) A coupling between atoms ",
 StyleBox["I",
  FontSlant->"Italic"],
 " and ",
 StyleBox["S",
  FontSlant->"Italic"],
 " of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["I", "-"], " ", 
     SubscriptBox["S", "+"]}], "+", 
    RowBox[{
     SubscriptBox["I", "+"], 
     SubscriptBox["S", "-"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b4d1210-5504-4beb-8836-454398196ec9"],
 "."
}], "Text",
 CellChangeTimes->{{3.998489030273728*^9, 3.9984892756965847`*^9}, 
   3.9984897782940903`*^9, {3.998490969192576*^9, 3.998490993842409*^9}, {
   3.998491046011813*^9, 
   3.9984910491688137`*^9}},ExpressionUUID->"9da30a7b-e1a7-45ed-9534-\
4a660078a3a8"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
