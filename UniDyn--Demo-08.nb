Cell["\<\
Using the Magnus expansion, compute a zeroth-order average Hamiltonian:\
\>", "Text",
 CellChangeTimes->{{3.99848893351805*^9, 
  3.998488981097124*^9}},ExpressionUUID->"fd5725da-8a76-4720-b4e2-\
8a7f98b069f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"H$1$int$0", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["1", "t$c"], " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"H$1$int", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "t$c"}], "}"}]}], "]"}]}], " ", "/.", " ", 
    RowBox[{"t$c", " ", "->", " ", 
     FractionBox[
      RowBox[{"2", " ", "\[Pi]"}], "\[CapitalDelta]"]}]}], "//", " ", 
   "Expand"}]}]], "Input",
 CellChangeTimes->{{3.998480933234034*^9, 3.9984809791043663`*^9}, {
  3.998481502650591*^9, 3.998481550790185*^9}},
 CellLabel->
  "In[522]:=",ExpressionUUID->"c9e7594b-611f-448e-ac12-3f90180c935c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g$I", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$m", ",", "aR"}], "]"}]}], "+", 
  RowBox[{"g$I", " ", "\[Omega]", " ", 
   RowBox[{"Mult", "[", 
    RowBox[{"I$p", ",", "aL"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.9985114117302628`*^9, 3.9985567427946367`*^9, 
